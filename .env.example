# Copy to .env and fill in. Never commit .env.

# --- Model providers: configure only those you want to use ---
# Keys are read by the server, never entered in the browser or committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Explicit native, Docker-service or remote endpoint; blank disables Ollama.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# Optional trusted HTTPS proxy endpoints (defaults shown):
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_REQUEST_TIMEOUT_SECONDS=180
# App output cap for alternative adapters, also bounded by advertised model limits.
ALTERNATIVE_MODEL_MAX_TOKENS=8192

# --- Optional: NewsCatcher (leave empty to use GDELT only) ---
NEWSCATCHER_API_KEY=
# "news" for keys from platform.newscatcherapi.com (current API); "v3" for Enterprise v3 keys
NEWSCATCHER_API=news
# low = 1 credit per search, medium = 5, high = 10 (better ranking, merges duplicate stories)
NEWSCATCHER_EFFORT=low
# While GDELT rate-limits this IP, run GDELT profiles' keywords through NewsCatcher instead
GDELT_FALLBACK_TO_NEWSCATCHER=true

# --- Shared team password for the web UI (HTTP Basic; any username). Strongly
#     recommended if the app is reachable by anyone other than you. ---
APP_PASSWORD=

# --- Models ---
# Existing installations default to Anthropic. Select provider/models in Settings
# after configuring credentials. No existing results are automatically reprocessed.
# Non-Anthropic adapters currently require effort=auto; use actual discovered IDs.
CLASSIFY_PROVIDER=anthropic
SUMMARY_PROVIDER=anthropic
CLASSIFY_MODEL=claude-opus-5-5
CLASSIFY_EFFORT=low
SUMMARY_MODEL=claude-opus-5-5
SUMMARY_EFFORT=high

# Minimum score (0-1) for an article to count towards a PIR
PIR_MATCH_THRESHOLD=0.5
CLASSIFY_CONCURRENCY=4
CLASSIFY_BATCH_SIZE=40

# Fetch full article text (GDELT supplies only headlines). Text is cut to this length
# before classification to control cost.
FETCH_ARTICLE_TEXT=true
ARTICLE_TEXT_MAX_CHARS=6000

WORKER_TICK_SECONDS=60

# --- Deployment ---
APP_PORT=8080
POSTGRES_PASSWORD=intel
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
